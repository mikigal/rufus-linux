<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Rufus</vendor>
  <vendor_url>https://rufus.ie</vendor_url>
  <icon_name>rufus</icon_name>
  <action id="ie.rufus.helper">
    <description>Write to USB drives with Rufus</description>
    <message>Authentication is required for Rufus to format and write to drives</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!-- A single prompt for the session, as with UAC on Windows -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@RUFUS_HELPER_PATH@</annotate>
  </action>
</policyconfig>
